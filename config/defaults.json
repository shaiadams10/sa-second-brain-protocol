{
  "schema_version": 1,
  "runtime_directory_name": "PersonalSecondBrain",
  "schedule": {
    "daily_time": "22:30",
    "weekly_day": "Saturday",
    "timezone": "America/New_York"
  },
  "models": {
    "daily": {
      "name": "gpt-5.6-luna",
      "reasoning": "medium"
    },
    "weekly": {
      "name": "gpt-5.6-terra",
      "reasoning": "medium"
    },
    "bootstrap": {
      "name": "gpt-5.6-sol",
      "reasoning": "high"
    },
    "escalation": {
      "name": "gpt-5.6-sol",
      "reasoning": "high"
    }
