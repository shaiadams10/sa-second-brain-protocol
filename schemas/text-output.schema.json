  "type": "object",
  "required": ["content", "evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "content": {"type": "string", "maxLength": 30000},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 100
    }
  }
}
